general {
    colors = true
    interval = 5
    color_good = "#a3be8c"
    color_bad = "#bf616a"
    color_degraded = "#ebcb8b"
    color_separator = "#4c566a"
}

order += "wireless _first_"
order += "cpu_usage"
order += "memory"
order += "volume master"
# Removed the duplicate read_file here to keep the bar clean
order += "tztime local"

wireless _first_ {
    format_up = "%quality %essid"
    format_down = "down"
}

cpu_usage {
    format = " %usage"
}

memory {
    format = " %percentage_used"
}

volume master {
    format = "󰕾 %volume"
    format_muted = "󰖁 muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

# Fixed the missing quote at the beginning of the name here:
tztime "local" {
    format = "%a,%m-%d |%H:%M:%S"
}
